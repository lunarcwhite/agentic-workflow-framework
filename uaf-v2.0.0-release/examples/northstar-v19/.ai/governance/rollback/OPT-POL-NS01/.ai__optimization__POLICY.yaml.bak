schema_version: '1.6'
enabled: true
min_observations: 3
adaptive:
  min_unused_rate: 0.60
  min_repeated_rate: 0.50
  min_memory_reuse_rate: 0.10
  max_replan_rate_per_task: 2.0
  min_gate_done_rate: 0.50
safety:
  auto_apply: false
  allow_policy_mutation: false
  allow_intent_mutation: false
  allow_memory_delete: false
